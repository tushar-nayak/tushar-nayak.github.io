---
layout: default
---
{% if page._styles %}
  <!-- Page/Post style -->
  <style type="text/css">
    {{ page._styles }}
  </style>
{% endif %}

<div class="post">
  {% if page.collection == 'projects' %}
    <header class="post-header case-study-hero">
      <div class="case-study-hero__content">
        {% if page.category %}
          <p class="case-study-hero__kicker">{{ page.category }}</p>
        {% endif %}
        <h1 class="post-title">{{ page.title }}</h1>
        <p class="post-description">{{ page.description }}</p>
      </div>
      {% if page.img %}
        <div class="case-study-hero__media">
          {%
            include figure.liquid
            loading="eager"
            path=page.img
            sizes="(min-width: 992px) 360px, 100vw"
            alt=page.title
            class="case-study-hero__image"
          %}
        </div>
      {% endif %}
    </header>
    {% include project_meta.liquid %}
    <article class="case-study case-study--project">
      {{ content }}
    </article>
  {% else %}
    <header class="post-header">
      <h1 class="post-title">{{ page.title }}</h1>
      {% if page.description %}
        <p class="post-description">{{ page.description }}</p>
      {% endif %}
    </header>

    <article>
      {{ content }}
    </article>
  {% endif %}

  {% if page.related_publications %}
    <h2>References</h2>
    <div class="publications">
      {% bibliography --cited_in_order %}
    </div>
  {% endif %}

  {% if site.giscus and page.giscus_comments %}
    {% include giscus.liquid %}
  {% endif %}
</div>
