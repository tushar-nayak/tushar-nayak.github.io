{% if page.website or page.github or page.report %}
  <div style="display: flex; flex-wrap: wrap; gap: 14px; margin: 24px 0 32px;">
    {% if page.website %}
      <a
        href="{{ page.website }}"
        target="_blank"
        rel="noopener noreferrer"
        style="display: inline-flex; align-items: center; gap: 10px; min-height: 48px; padding: 12px 18px; border-radius: 12px; border: 1px solid rgba(0, 123, 255, 0.3); background: linear-gradient(135deg, rgba(0, 123, 255, 0.12), rgba(0, 200, 180, 0.08)); color: inherit; text-decoration: none; font-weight: 700; box-shadow: 0 8px 20px rgba(0, 0, 0, 0.08); transition: transform 0.18s ease, box-shadow 0.18s ease, border-color 0.18s ease;"
        onmouseover="this.style.transform='translateY(-2px)'; this.style.boxShadow='0 14px 28px rgba(0, 0, 0, 0.14)'; this.style.borderColor='rgba(0, 123, 255, 0.55)'"
        onmouseout="this.style.transform='translateY(0)'; this.style.boxShadow='0 8px 20px rgba(0, 0, 0, 0.08)'; this.style.borderColor='rgba(0, 123, 255, 0.3)'"
      >
        <i class="fa-solid fa-arrow-up-right-from-square"></i>
        <span>Project Website</span>
      </a>
    {% endif %}
    {% if page.github %}
      <a
        href="{{ page.github }}"
        target="_blank"
        rel="noopener noreferrer"
        style="display: inline-flex; align-items: center; gap: 10px; min-height: 48px; padding: 12px 18px; border-radius: 12px; border: 1px solid rgba(128, 128, 128, 0.35); background: linear-gradient(135deg, rgba(36, 41, 46, 0.12), rgba(128, 128, 128, 0.06)); color: inherit; text-decoration: none; font-weight: 700; box-shadow: 0 8px 20px rgba(0, 0, 0, 0.08); transition: transform 0.18s ease, box-shadow 0.18s ease, border-color 0.18s ease;"
        onmouseover="this.style.transform='translateY(-2px)'; this.style.boxShadow='0 14px 28px rgba(0, 0, 0, 0.14)'; this.style.borderColor='rgba(128, 128, 128, 0.6)'"
        onmouseout="this.style.transform='translateY(0)'; this.style.boxShadow='0 8px 20px rgba(0, 0, 0, 0.08)'; this.style.borderColor='rgba(128, 128, 128, 0.35)'"
      >
        <i class="fa-brands fa-github"></i>
        <span>Source Code</span>
      </a>
    {% endif %}
    {% if page.report %}
      <a
        href="{{ page.report }}"
        target="_blank"
        rel="noopener noreferrer"
        style="display: inline-flex; align-items: center; gap: 10px; min-height: 48px; padding: 12px 18px; border-radius: 12px; border: 1px solid rgba(181, 9, 172, 0.3); background: linear-gradient(135deg, rgba(181, 9, 172, 0.1), rgba(128, 128, 128, 0.06)); color: inherit; text-decoration: none; font-weight: 700; box-shadow: 0 8px 20px rgba(0, 0, 0, 0.08); transition: transform 0.18s ease, box-shadow 0.18s ease, border-color 0.18s ease;"
        onmouseover="this.style.transform='translateY(-2px)'; this.style.boxShadow='0 14px 28px rgba(0, 0, 0, 0.14)'; this.style.borderColor='rgba(181, 9, 172, 0.55)'"
        onmouseout="this.style.transform='translateY(0)'; this.style.boxShadow='0 8px 20px rgba(0, 0, 0, 0.08)'; this.style.borderColor='rgba(181, 9, 172, 0.3)'"
      >
        <i class="fa-solid fa-file-lines"></i>
        <span>Report</span>
      </a>
    {% endif %}
  </div>
{% endif %}
