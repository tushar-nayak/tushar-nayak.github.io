{% if page.website or page.github or page.report %}
  <div class="project-link-list">
    {% if page.website %}
      <a href="{{ page.website }}" target="_blank" rel="noopener noreferrer" class="project-link project-link--website">
        <i class="fa-solid fa-arrow-up-right-from-square"></i>
        <span>Project Website</span>
      </a>
    {% endif %}
    {% if page.github %}
      <a href="{{ page.github }}" target="_blank" rel="noopener noreferrer" class="project-link project-link--github">
        <i class="fa-brands fa-github"></i>
        <span>Source Code</span>
      </a>
    {% endif %}
    {% if page.report %}
      <a href="{{ page.report }}" target="_blank" rel="noopener noreferrer" class="project-link project-link--report">
        <i class="fa-solid fa-file-lines"></i>
        <span>Report</span>
      </a>
    {% endif %}
  </div>
{% endif %}
