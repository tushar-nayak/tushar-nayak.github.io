{% assign repo_url = include.repository | split: '/' %}
{% assign matched_project = site.projects | where_exp: 'project', 'project.github contains include.repository' | first %}

<div class="repo p-2">
  <a class="repo-card" href="https://github.com/{{ include.repository }}" target="_blank" rel="noopener noreferrer">
    <div class="repo-card__body">
      <div class="repo-card__header">
        <div class="repo-card__title-wrap">
          <p class="repo-card__eyebrow">Repository</p>
          <h3>
            {% if matched_project %}
              {{ matched_project.title }}
            {% else %}
              {{ repo_url[1] | replace: '-', ' ' | replace: '_', ' ' | capitalize }}
            {% endif %}
          </h3>
        </div>
        <span class="repo-card__github-mark">
          <i class="fa-brands fa-github"></i>
        </span>
      </div>

      <p class="repo-card__path">{{ include.repository }}</p>

      {% if matched_project %}
        <p class="repo-card__description">{{ matched_project.description }}</p>

        <div class="project-card-meta">
          {% if matched_project.status %}
            <span class="project-card-status">{{ matched_project.status }}</span>
          {% endif %}
        </div>
      {% else %}
        <p class="repo-card__description">GitHub repository for code, experiments, and documentation.</p>
      {% endif %}

    </div>
  </a>
</div>
