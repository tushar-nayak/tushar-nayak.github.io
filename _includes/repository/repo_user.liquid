<div class="repo p-2">
  <a class="repo-card repo-card--profile" href="https://github.com/{{ include.username }}" target="_blank" rel="noopener noreferrer">
    <div class="repo-card__icon">
      <i class="fa-brands fa-github"></i>
    </div>
    <div class="repo-card__body">
      <p class="repo-card__eyebrow">GitHub Profile</p>
      <h3>{{ include.username }}</h3>
      <p>Public code for research projects, experiments, and this website.</p>
    </div>
  </a>
</div>
