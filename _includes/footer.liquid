{% assign social_data = site.data.socials %}

{% capture footer_contents %}
  <div class="site-footer">
    <div class="site-footer__links">
      {% if social_data.email %}
        <a href="mailto:{{ social_data.email | encode_email }}">email</a>
      {% endif %}
      <a href="{{ '/output/pdf/Tushar_Nayak_Resume.pdf' | relative_url }}">resume</a>
      {% if social_data.github_username %}
        <a href="https://github.com/{{ social_data.github_username }}" target="_blank" rel="noopener noreferrer">github</a>
      {% endif %}
      {% if social_data.scholar_userid %}
        <a
          href="https://scholar.google.com/citations?user={{ social_data.scholar_userid }}"
          target="_blank"
          rel="noopener noreferrer"
        >scholar</a>
      {% endif %}
      {% if social_data.linkedin_username %}
        <a
          href="https://www.linkedin.com/in/{{ social_data.linkedin_username }}"
          target="_blank"
          rel="noopener noreferrer"
        >linkedin</a>
      {% endif %}
    </div>

    <div class="site-footer__meta">
      <span>&copy; {{ site.time | date: '%Y' }}</span>
    </div>
  </div>
{% endcapture %}

{% if site.footer_fixed %}
  <footer class="fixed-bottom" role="contentinfo">
    <div class="container mt-0">
      {{ footer_contents }}
    </div>
  </footer>
{% else %}
  <footer class="sticky-bottom mt-5" role="contentinfo">
    {% if site.newsletter.enabled %}
      {% include newsletter.liquid %}
    {% endif %}

    <div class="container">
      {{ footer_contents }}
    </div>
  </footer>
{% endif %}
