{% assign homepage_featured = site.projects | where: 'homepage_featured', true | sort: 'homepage_order' %}

{% if homepage_featured.size > 0 %}
  <ul class="featured-projects-list">
    {% for project in homepage_featured limit: 3 %}
      <li class="featured-project-entry">
        <div class="title"><a href="{{ project.url | relative_url }}">{{ project.title }}</a></div>
        <div class="periodical">{{ project.description }}</div>
      </li>
    {% endfor %}
  </ul>
{% endif %}
