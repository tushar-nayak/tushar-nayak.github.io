{% assign homepage_featured = site.projects | where: 'homepage_featured', true | sort: 'homepage_order' %}

{% if homepage_featured.size > 0 %}
  <section class="home-work">
    <div class="section-shell__heading-row">
      <p class="section-shell__eyebrow">selected work</p>
      <a class="section-shell__inline-link" href="{{ '/projects/' | relative_url }}">all projects <span aria-hidden="true">↗</span></a>
    </div>
    <div class="home-work__grid">
      {% for project in homepage_featured limit: 3 %}
        <a class="home-work__card" href="{{ project.url | relative_url }}">
          <span class="home-work__index">0{{ forloop.index }}</span>
          <div class="home-work__body">
            <h3>{{ project.homepage_title | default: project.title }}</h3>
            <p>{{ project.description }}</p>
          </div>
          <span class="home-work__arrow" aria-hidden="true">↗</span>
        </a>
      {% endfor %}
    </div>
  </section>
{% endif %}
