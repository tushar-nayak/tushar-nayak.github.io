{% assign homepage_featured = site.projects | where: 'homepage_featured', true | sort: 'homepage_order' %}

{% if homepage_featured.size > 0 %}
  <section class="featured-projects">
    <div class="featured-projects__heading-row">
      <p class="section-shell__eyebrow">selected work</p>
      <a class="section-shell__inline-link" href="{{ '/projects/' | relative_url }}">all projects <span aria-hidden="true">↗</span></a>
    </div>
    <div class="featured-projects__list">
      {% for project in homepage_featured limit: 3 %}
        <a class="featured-project" href="{{ project.url | relative_url }}">
          <span class="featured-project__index">0{{ forloop.index }}</span>
          <div class="featured-project__body">
            <h3>{{ project.title }}</h3>
            <p>{{ project.description }}</p>
          </div>
          <span class="featured-project__arrow" aria-hidden="true">↗</span>
        </a>
      {% endfor %}
    </div>
  </section>
{% endif %}
