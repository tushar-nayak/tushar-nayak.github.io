<div class="col pf-item" data-filter-tags="{{ project.tags | join: ',' }}">
  <a href="{% if project.redirect %}{{ project.redirect }}{% else %}{{ project.url | relative_url }}{% endif %}">
    <div class="card h-100 hoverable project-card">
      {% if project.img %}
        {%
          include figure.liquid
          loading="eager"
          path=project.img
          sizes = "250px"
          alt="project thumbnail"
          class="card-img-top"
        %}
      {% endif %}
      <div class="card-body">
        {% if project.category %}
          <p class="project-card-kicker">{{ project.category }}</p>
        {% endif %}
        <p class="project-card-path">projects/{{ project.slug | default: project.title | slugify }}</p>
        <h2 class="card-title">{{ project.title }}</h2>
        {% if project.status or project.tags %}
          <div class="project-card-meta">
            {% if project.status %}
              <span class="project-card-status">status: {{ project.status }}</span>
            {% endif %}
            {% for tag in project.tags limit: 3 %}
              <span class="project-card-tag">tag: {{ tag }}</span>
            {% endfor %}
          </div>
        {% endif %}
        <p class="card-text">{{ project.description }}</p>
        <p class="project-card-cta">View case study</p>
      </div>
    </div>
  </a>
</div>
